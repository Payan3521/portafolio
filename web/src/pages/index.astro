---
// web/src/pages/index.astro
// Página raíz: redirige al idioma preferido del visitante.
// Usa BASE_URL para que funcione con cualquier base (/, /portafolio/, etc.)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Juan Pablo Bedoya Payán — Portafolio</title>
    <link rel="canonical" href="{import.meta.env.BASE_URL}es/" />
    <meta http-equiv="refresh" content="0; url={import.meta.env.BASE_URL}es/" />
    <link rel="alternate" hreflang="es" href="{import.meta.env.BASE_URL}es/" />
    <link rel="alternate" hreflang="en" href="{import.meta.env.BASE_URL}en/" />
    <link rel="alternate" hreflang="x-default" href="{import.meta.env.BASE_URL}es/" />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #080810; color: #99a2bd; font-family: system-ui, sans-serif; }
      a { color: #22d3ee; }
    </style>
  </head>
  <body>
    <p>Redirigiendo… <a href="{import.meta.env.BASE_URL}es/">Español</a> · <a href="{import.meta.env.BASE_URL}en/">English</a></p>
    <script is:inline>
      (function () {
        var lang = (navigator.language || 'es').toLowerCase();
        var base = import.meta.env.BASE_URL || '/';
        var target = lang.indexOf('en') === 0 ? base + 'en/' : base + 'es/';
        window.location.replace(target);
      })();
    </script>
  </body>
</html>