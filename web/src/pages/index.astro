---
// web/src/pages/index.astro
import { profile } from '../data/profile';

const site = profile.site.replace(/\/$/, '');
const esUrl = `${site}/es/`;
const enUrl = `${site}/en/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Juan Pablo Bedoya Payán — Portafolio</title>
    <link rel="canonical" href={esUrl} />
    <meta http-equiv="refresh" content={`0; url=${esUrl}`} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #080810; color: #99a2bd; font-family: system-ui, sans-serif; }
      a { color: #22d3ee; text-decoration: none; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <p>Redirigiendo… <a href={esUrl}>Español</a> · <a href={enUrl}>English</a></p>
    <script is:inline define:vars={{ esUrl, enUrl }}>
      (function () {
        var lang = (navigator.language || 'es').toLowerCase();
        var target = lang.indexOf('en') === 0 ? enUrl : esUrl;
        window.location.replace(target);
      })();
    </script>
  </body>
</html>
