---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { education, certifications } from '../data/education';
import { t } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
---

<section id="education" class="section">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading title={tr('education.title')} subtitle={tr('education.subtitle')} eyebrow="04" />

    <div class="mt-14 grid gap-10 lg:grid-cols-2">
      <!-- Formación académica -->
      <ol class="relative">
        <span class="timeline-line absolute bottom-2 left-[0.4rem] top-3 w-px" aria-hidden="true"></span>
        {
          education.map((item, i) => (
            <li class="relative pb-8 pl-10 last:pb-0" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="dot absolute left-0 top-[1.4rem]" aria-hidden="true"></span>
              <div class="card p-6">
                <div class="flex items-center justify-between gap-3">
                  {item.logo ? (
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-border bg-surface p-2 shadow-sm">
                      <img
                        src={`${import.meta.env.BASE_URL}${item.logo.replace(/^\//, '')}`}
                        alt={item.institution}
                        class="h-full w-full object-contain"
                        loading="lazy"
                      />
                    </div>
                  ) : (
                    <span class="icon-badge h-10 w-10">
                      <Icon name="graduation-cap" size={18} />
                    </span>
                  )}
                  <span class="chip shrink-0">
                    {item.start} — {item.end ?? tr('experience.present')}
                  </span>
                </div>
                <h3 class="mt-4 text-base font-semibold text-text">{t(lang, item.degree)}</h3>
                <p class="mt-1 text-sm font-medium text-accent-2">{item.institution}</p>
                <p class="mt-3 text-sm leading-relaxed text-muted">{t(lang, item.description)}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Certificaciones -->
      <div data-reveal style="--reveal-delay:120ms">
        <h3 class="mb-5 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-text">
          <span class="text-accent-2"><Icon name="award" size={16} /></span>
          {tr('education.certifications')}
        </h3>
        <ul class="space-y-3">
          {
            certifications.map((cert) => (
              <li class="card flex items-center gap-4 p-4">
                <span class="icon-badge h-11 w-11">
                  <Icon name="award" size={19} />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-semibold text-text">{cert.name}</span>
                  <span class="block text-xs text-muted">
                    {cert.issuer} · {cert.year}
                  </span>
                </span>
                {cert.url && (
                  <a
                    href={cert.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-border text-muted transition-colors hover:border-accent hover:text-accent-2"
                    aria-label={cert.name}
                  >
                    <Icon name="external-link" size={16} />
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
