const logo = techLogos[name] || `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m10 9-3 3 3 3m4-6 3 3-3 3"/></svg>`;
---

<div class={className || 'tech-logo'}>
  <div class="tech-logo-svg flex items-center justify-center w-7 h-7" set:html={logo} />
</div>

<style is:global>
  .tech-logo-svg svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
