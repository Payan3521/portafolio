---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const role = profile.role[lang];
const tagline = profile.tagline[lang];
const resume = profile.resume[lang];

const socials = [
  { name: 'github', href: profile.social.github, label: 'GitHub', icon: 'github' },
  { name: 'linkedin', href: profile.social.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { name: 'whatsapp', href: profile.social.whatsapp, label: 'WhatsApp', icon: 'phone' },
  { name: 'email', href: `mailto:${profile.email}`, label: 'Email', icon: 'mail' },
].filter((s) => s.href);
---

<section id="hero" class="relative flex min-h-[100svh] items-center pt-28 pb-16">
  <div class="mx-auto grid w-full max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1.15fr_0.85fr]">
    <!-- Texto -->
    <div data-reveal>
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-white/[0.03] px-4 py-1.5 text-xs font-medium text-muted">
        <span class="dot h-2 w-2 animate-pulse-dot"></span>
        {tr('hero.available')}
      </span>

      <p class="mt-6 font-mono text-sm text-accent-2">{tr('hero.greeting')}</p>

      <h1 class="mt-2 text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.05]">
        <span class="gradient-text">{profile.name}</span>
      </h1>

      <p class="mt-4 text-xl font-semibold text-text/90 sm:text-2xl">{role}</p>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">{tagline}</p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#contact" class="btn btn-primary">
          {tr('hero.contact')}
          <Icon name="arrow-right" size={17} />
        </a>

        <!-- Botón CV con selector directo ES / EN -->
        <div class="inline-flex items-center rounded-xl border border-border bg-surface p-1 shadow-sm transition-colors hover:border-accent/40">
          <a
            href={`${import.meta.env.BASE_URL}${resume.replace(/^\//, '')}`}
            class="inline-flex items-center gap-2 rounded-lg px-3.5 py-2 text-sm font-semibold text-text transition-colors hover:bg-bg-soft hover:text-accent-2"
            download
            title={lang === 'es' ? 'Descargar hoja de vida en PDF' : 'Download CV in PDF'}
          >
            <Icon name="download" size={16} />
            <span>{tr('hero.downloadCV')}</span>
          </a>
          <span class="mx-0.5 h-4 w-px bg-border"></span>
          <div class="flex items-center px-1 text-xs font-mono font-medium">
            <a
              href={`${import.meta.env.BASE_URL}${profile.resume.es.replace(/^\//, '')}`}
              download
              class={`rounded px-1.5 py-1 transition-colors ${lang === 'es' ? 'text-accent-2 font-bold bg-accent/15' : 'text-muted hover:text-text'}`}
              title="Descargar versión en Español"
            >
              ES
            </a>
            <span class="text-border/60">/</span>
            <a
              href={`${import.meta.env.BASE_URL}${profile.resume.en.replace(/^\//, '')}`}
              download
              class={`rounded px-1.5 py-1 transition-colors ${lang === 'en' ? 'text-accent-2 font-bold bg-accent/15' : 'text-muted hover:text-text'}`}
              title="Download English version"
            >
              EN
            </a>
          </div>
        </div>
      </div>

      <ul class="mt-9 flex items-center gap-3">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="grid h-11 w-11 place-items-center rounded-xl border border-border text-muted transition-all hover:-translate-y-1 hover:border-accent hover:text-accent-2"
              >
                <Icon name={s.icon} size={19} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Foto -->
    <div class="relative mx-auto w-full max-w-sm" data-reveal style="--reveal-delay:150ms">
      <div
        class="absolute -inset-6 rounded-[2.5rem] opacity-60 blur-2xl"
        style="background:radial-gradient(circle at 30% 20%, rgb(139 92 246 / 0.5), transparent 60%), radial-gradient(circle at 75% 80%, rgb(34 211 238 / 0.45), transparent 60%)"
        aria-hidden="true"
      ></div>

      <div class="relative rounded-[2rem] border border-border bg-surface/60 p-3 backdrop-blur">
        <div class="overflow-hidden rounded-[1.4rem] bg-bg-soft">
          <img
            src={`${import.meta.env.BASE_URL}${profile.photo.replace(/^\//, '')}`}
            alt={`${profile.name} — ${role}`}
            width="480"
            height="560"
            class="h-full w-full object-cover object-top aspect-[4/5]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <!-- Badges flotantes -->
      <div
        class="glass absolute -left-4 top-10 hidden animate-float items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium sm:flex"
      >
        <span class="text-accent-2"><Icon name="code" size={16} /></span>
        Full Stack
      </div>
      <div
        class="glass absolute -right-3 bottom-14 hidden animate-float items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium sm:flex"
        style="animation-delay:-3s"
      >
        <span class="text-accent-2"><Icon name="sparkles" size={16} /></span>
        {lang === 'es' ? 'Clean code' : 'Clean code'}
      </div>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <a
    href="#about"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-xs text-muted transition-colors hover:text-accent-2 sm:flex"
    aria-label={tr('hero.scroll')}
  >
    <span class="font-mono">{tr('hero.scroll')}</span>
    <Icon name="arrow-down" size={16} class="animate-float" />
  </a>
</section>
