---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { t } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);

const contactItems = [
  { icon: 'mail', label: tr('contact.email'), value: profile.email, href: `mailto:${profile.email}` },
  { icon: 'phone', label: tr('contact.phone'), value: profile.phone, href: `tel:${profile.phone.replace(/\s/g, '')}` },
  { icon: 'map-pin', label: tr('contact.location'), value: t(lang, profile.location), href: null },
];

const socials = [
  { name: 'GitHub', href: profile.social.github, icon: 'github' },
  { name: 'LinkedIn', href: profile.social.linkedin, icon: 'linkedin' },
  { name: 'WhatsApp', href: profile.social.whatsapp, icon: 'phone' },
].filter((s) => s.href);

// 👉 REGÍSTRATE EN https://web3forms.com (gratis, sin backend) Y PEGA TU ACCESS KEY AQUÍ
// Mientras no configures la clave, el formulario abre el cliente de correo (mailto) como fallback.
const WEB3FORMS_KEY = '2a4b22cb-e00a-4c39-8bfa-afd0623907b6';
---

<section id="contact" class="section">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading title={tr('contact.title')} subtitle={tr('contact.subtitle')} eyebrow="06" />

    <div class="mt-14 grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <!-- Información -->
      <div data-reveal>
        <p class="max-w-md text-base leading-relaxed text-muted">{tr('contact.lead')}</p>

        <ul class="mt-8 space-y-3">
          {
            contactItems.map((item) => {
              const Wrapper = item.href ? 'a' : 'div';
              return (
                <li>
                  <Wrapper
                    href={item.href ?? undefined}
                    class="flex items-center gap-4 rounded-xl border border-border-soft bg-white/[0.02] p-4 transition-colors hover:border-accent/50"
                  >
                    <span class="icon-badge h-11 w-11">
                      <Icon name={item.icon} size={18} />
                    </span>
                    <span>
                      <span class="block text-xs text-muted">{item.label}</span>
                      <span class="block text-sm font-medium text-text">{item.value}</span>
                    </span>
                  </Wrapper>
                </li>
              );
            })
          }
        </ul>

        <div class="mt-8">
          <span class="text-xs uppercase tracking-wider text-muted">{tr('contact.social')}</span>
          <ul class="mt-3 flex gap-3">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.name}
                    class="grid h-11 w-11 place-items-center rounded-xl border border-border text-muted transition-all hover:-translate-y-1 hover:border-accent hover:text-accent-2"
                  >
                    <Icon name={s.icon} size={19} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Formulario -->
      <div class="card p-6 sm:p-8" data-reveal style="--reveal-delay:120ms">
        <form
          id="contact-form"
          class="space-y-5"
          data-key={WEB3FORMS_KEY}
          data-email={profile.email}
          data-success={tr('form.success')}
          data-error={tr('form.error')}
          novalidate
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="flex flex-col gap-2">
              <span class="text-xs font-medium text-muted">{tr('form.name')}</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                class="rounded-xl border border-border bg-bg-soft px-4 py-3 text-sm text-text outline-none transition-colors placeholder:text-muted/60 focus:border-accent"
                placeholder="María Pérez"
              />
            </label>
            <label class="flex flex-col gap-2">
              <span class="text-xs font-medium text-muted">{tr('form.email')}</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="rounded-xl border border-border bg-bg-soft px-4 py-3 text-sm text-text outline-none transition-colors placeholder:text-muted/60 focus:border-accent"
                placeholder="tu@correo.com"
              />
            </label>
          </div>

          <label class="flex flex-col gap-2">
            <span class="text-xs font-medium text-muted">{tr('form.message')}</span>
            <textarea
              name="message"
              required
              rows="5"
              class="resize-y rounded-xl border border-border bg-bg-soft px-4 py-3 text-sm text-text outline-none transition-colors placeholder:text-muted/60 focus:border-accent"
              placeholder={tr('form.message')}></textarea>
          </label>

          <button type="submit" class="btn btn-primary w-full" data-submit>
            <Icon name="send" size={17} />
            {tr('form.send')}
          </button>

          <p id="form-status" class="hidden rounded-xl border px-4 py-3 text-sm" role="status"></p>

          <p class="text-center text-xs text-muted">
            {tr('form.or')}{' '}
            <a href={`mailto:${profile.email}`} class="font-medium text-accent-2 hover:underline">{profile.email}</a>
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  if (form && status) {
    const key = form.dataset.key ?? '';
    const fallbackEmail = form.dataset.email ?? '';
    const successMsg = form.dataset.success ?? 'Sent!';
    const errorMsg = form.dataset.error ?? 'Error';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '');
      const email = String(data.get('email') ?? '');
      const message = String(data.get('message') ?? '');
      const button = form.querySelector('[data-submit]') as HTMLButtonElement | null;

      const show = (msg: string, ok: boolean) => {
        status.textContent = msg;
        status.className =
          'rounded-xl border px-4 py-3 text-sm ' +
          (ok
            ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300'
            : 'border-red-500/40 bg-red-500/10 text-red-300');
      };

      // Si no se configuró la clave, se abre el cliente de correo (fallback).
      if (!key || key === 'TU_ACCESS_KEY_AQUI') {
        window.location.href = `mailto:${fallbackEmail}?subject=${encodeURIComponent(
          'Contacto web: ' + name,
        )}&body=${encodeURIComponent(message + '\n\n' + email)}`;
        return;
      }

      button && (button.disabled = true);
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: key,
            name,
            email,
            message,
            subject: `Nuevo mensaje de ${name}`,
          }),
        });
        const json = await res.json();
        if (json.success) {
          form.reset();
          show(successMsg, true);
        } else {
          show(errorMsg, false);
        }
      } catch {
        show(errorMsg, false);
      } finally {
        button && (button.disabled = false);
      }
    });
  }
</script>
