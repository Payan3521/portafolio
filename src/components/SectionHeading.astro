---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  align?: 'center' | 'left';
}

const { title, subtitle, eyebrow, align = 'center' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  {
    eyebrow && (
      <span class="eyebrow justify-center">
        <span class="h-px w-8 bg-gradient-to-r from-transparent to-accent-2"></span>
        {eyebrow}
      </span>
    )
  }
  <h2 class="mt-3 text-[clamp(1.9rem,4vw,2.75rem)]">
    <span class="gradient-text">{title}</span>
  </h2>
  {subtitle && <p class="mt-4 text-base leading-relaxed text-muted">{subtitle}</p>}
</div>
